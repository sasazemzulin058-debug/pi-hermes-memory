+    // Backup markdown file for atomic rollback
+    const memoryFile = path.join(resolvedMemoryDir, MEMORY_FILE);
+    let backupContent: string | null = null;
+    try {
+      backupContent = await fs.readFile(memoryFile, "utf-8");
+    } catch {
+      backupContent = "";
